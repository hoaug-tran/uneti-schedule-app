{
  "name": "uneti-schedule-widget",
  "version": "1.9.4",
  "description": "Widget lịch học UNETI",
  "author": "Trần Kính Hoàng (hoaug)",
  "type": "module",
  "main": "main/main.js",
  "scripts": {
    "fetch": "node app/fetcher/getSchedule.js",
    "dev": "cross-env NODE_ENV=development electron .",
    "test": "node --experimental-vm-modules --test test/*.test.js",
    "check": "node scripts/check-syntax.js",
    "release:notes": "node scripts/release-notes.js",
    "prebuild": "npm run release:notes",
    "build": "electron-builder",
    "postbuild": "node scripts/verify-build.js && npm run release:notes",
    "update-server": "http-server ./dist -p 8080 --cors"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "http-server": "^14.1.1",
    "js-yaml": "^5.5.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "electron-store": "^11.0.2",
    "electron-updater": "6.8.9",
    "keytar": "^7.9.0"
  },
  "build": {
    "appId": "com.hoaug.uneti.schedule",
    "productName": "Widget lịch học UNETI",
    "artifactName": "uneti-schedule-widget-${version}-setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app/assets/",
        "to": "assets"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hoaug-tran",
        "repo": "uneti-schedule-app"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "app/assets/uneti.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": true,
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "installerHeaderIcon": "app/assets/uneti.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Widget lịch học UNETI",
      "menuCategory": false,
      "displayLanguageSelector": false
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
